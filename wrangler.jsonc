// Cloudflare Workers deployment: the built site in dist/ served as static assets, with one small
// Worker in front of /api/* for the Instagram feed. Workers Builds runs `npm run build` and then
// `npx wrangler deploy`; this file is what stops Wrangler from "auto-configuring" the project
// (which installs the Astro Cloudflare adapter, moves the output to dist/client and breaks the
// link check). Keep the name in step with the Worker in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pomi-brow",
  "compatibility_date": "2026-09-11",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Astro builds /about/index.html with trailingSlash "never": serve it at /about, and send
    // /about/ there. public/_redirects and _headers apply as on Pages.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Only the API reaches the Worker; every other request is answered from the assets directly.
    "run_worker_first": ["/api/*"]
  },
  // Per-IP limit on the contact form (src/lib/contact.ts): 5 sends a minute per Cloudflare
  // location. namespace_id is any integer unique within the Cloudflare account.
  "ratelimits": [{ "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  // The appointment form emails through Resend. Set in the dashboard (Settings → Variables and
  // secrets) or with `wrangler secret put <NAME>`:
  //   RESEND_API_KEY    secret, from resend.com/api-keys
  //   APPOINTMENT_TO    where requests go (comma-separate several addresses)
  //   APPOINTMENT_FROM  optional; on a domain verified in Resend, default
  //                     "Pomi B. Brow Studio website <website@pomibbrowstudio.com>"
  // keep_vars stops `wrangler deploy` from deleting plain variables typed into the dashboard
  // (secrets always survive), so APPOINTMENT_TO can be a plain variable without being wiped.
  "keep_vars": true,
  // INSTAGRAM_ACCESS_TOKEN is a secret too, if the live feed is wanted.
  // To enable weekly token refresh, create a KV namespace and add its id here:
  // "kv_namespaces": [{ "binding": "INSTAGRAM_KV", "id": "<namespace id>" }],
  "observability": { "enabled": true }
}
