# Copy to .env and fill in. Every value is optional for a local build:
# without a Sanity project the site renders from src/content/seed/*.json.

# Sanity (create at sanity.io/manage). Studio lives at /admin on the deployed site.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Cloudflare Web Analytics token (cookieless, no consent banner needed).
PUBLIC_CF_ANALYTICS_TOKEN=

# Appointment form, emailed through Resend. For local `wrangler dev` put these in .dev.vars;
# in production set them on the Worker (Settings → Variables and secrets).
# Required. Create at https://resend.com/api-keys and add it as a Secret.
RESEND_API_KEY=
# Required. Where requests are delivered; comma-separate several addresses.
APPOINTMENT_TO=
# Optional. Must be on a domain verified in Resend (https://resend.com/domains), or sending fails.
# Defaults to "Pomi B. Brow Studio website <website@pomibbrowstudio.com>".
APPOINTMENT_FROM=

# Instagram live feed (home page "Recent work"). The account must be a Business or Creator account.
# 1. developers.facebook.com → My apps → Create app → add the "Instagram" product.
# 2. Instagram → "API setup with Instagram login" → add @pomib.browstudio as an Instagram tester,
#    then accept the invite in the Instagram app (Settings → Website permissions → Tester invites).
# 3. "Generate token" for that account. It is long-lived (60 days). Paste it here for local dev and
#    in Cloudflare Pages → Settings → Environment variables (encrypt it) for production.
# 4. Production only: create a KV namespace and bind it as INSTAGRAM_KV under Pages → Settings →
#    Functions → KV namespace bindings. The function then refreshes the token weekly by itself;
#    without the binding the token must be regenerated by hand before it expires. If you paste a
#    new token, the function notices and starts over from it; the old KV record is ignored.
#    For the first 24 hours after generating a token the weekly refresh logs
#    "Instagram responded 400"; that is expected and harmless — Meta will not refresh a token
#    younger than a day.
# Local dev without a token serves tests/fixtures/instagram-media.json instead.
# Full walkthrough, including the Cloudflare KV binding and troubleshooting: docs/instagram-feed-setup.md
INSTAGRAM_ACCESS_TOKEN=
# Optional. Only used for the alt-text fallback ("New post from @handle"). Defaults to pomib.browstudio.
INSTAGRAM_HANDLE=
