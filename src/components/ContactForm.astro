---
// The contact form plus the studio's location. Submissions go to POST /api/contact (src/lib/contact.ts), never to Sanity.
import type { SiteSettings, Service } from "../lib/content";
import { localPhoto } from "../lib/content";
import Icon from "./Icon.astro";
import Photo from "./Photo.astro";
import MapEmbed from "./MapEmbed.astro";

interface Props {
  settings: SiteSettings;
  services: Service[];
}
const { settings, services } = Astro.props;
const options = services.filter((s) => ["Eyebrows", "Eyes", "Lips", "Hair"].includes(s.category));
// What a first-timer walks into, so the address has a place attached to it.
const studioPhoto = localPhoto(
  "studio/interior",
  "Inside the studio: the Pomi B. sign on a grey wall beside a pink wall of paper roses"
);
---

<section class="contact section" id="contact" aria-labelledby="contact-heading">
  <div class="page contact__grid">
    <div class="contact__form-col reveal">
      <div class="section-head" style="margin-bottom: var(--space-6)">
        <h2 id="contact-heading">Request an appointment.</h2>
        <p class="lede">
          Tell Pomi what you have in mind and she will call or text you to find a time. Not sure which service fits? Ask that
          too. Pomi answers herself.
        </p>
      </div>

      <form class="form" method="post" action="/api/contact" data-contact-form>
        <div class="form__row">
          <label class="form__field">
            <span class="form__label">Your name</span>
            <input type="text" name="name" autocomplete="name" required />
          </label>
          <label class="form__field">
            <span class="form__label">Phone</span>
            <input type="tel" name="phone" autocomplete="tel" inputmode="tel" required />
          </label>
        </div>
        <label class="form__field">
          <span class="form__label">Email <span class="form__optional">optional</span></span>
          <input type="email" name="email" autocomplete="email" inputmode="email" />
        </label>
        <label class="form__field">
          <span class="form__label">Interested in</span>
          <span class="form__select">
            <select name="service">
              <option value="">Not sure yet</option>
              {options.map((s) => <option value={s.slug}>{s.title}</option>)}
              <option value="touch-up">A touch-up on existing work</option>
              <option value="removal">Removal or correction</option>
            </select>
          </span>
        </label>
        <label class="form__field">
          <span class="form__label">What you would like, or your question</span>
          <textarea name="message" rows="4" required></textarea>
        </label>
        <label class="form__trap" aria-hidden="true">
          Leave this empty
          <input type="text" name="pomi_hp_note" tabindex="-1" autocomplete="off" />
        </label>

        <p class="form__status" id="contact-status" role="status" aria-live="polite" data-status hidden></p>

        <div class="form__actions">
          <button class="btn" type="submit" data-submit>
            <span data-submit-label>Send request</span>
            <Icon name="arrow" />
          </button>
          <p class="form__aside">
            Or call <a href={`tel:${settings.phoneTel}`}>{settings.phone}</a> or
            <a href={`sms:${settings.phoneTel}`}>send a text</a>
          </p>
        </div>
        <p class="form__consent">
          By sending this, you agree Pomi may call or text you about your appointment. See the <a href="/privacy">privacy policy</a>.
        </p>
      </form>
    </div>

    <div class="contact__where reveal" style="--i: 1">
      <div class="card contact__card">
        {studioPhoto && <Photo photo={studioPhoto} ratio="3 / 2" sizes="(min-width: 60rem) 30vw, 100vw" widths={[480, 800, 1200]} />}
        <p class="contact__head">The studio</p>
        <address class="contact__address">
          <strong>{settings.businessName}</strong><br />
          {settings.street}<br />
          {settings.city}, {settings.state} {settings.zip}
        </address>
        <p class="muted">Serving Irvine and Orange County.</p>
        <p class="muted">
          {
            settings.hours.length > 0
              ? settings.hours.map((h) => (
                  <span>
                    {h.days}: {h.opens}–{h.closes}
                    <br />
                  </span>
                ))
              : settings.hoursNote
          }
        </p>
        <MapEmbed settings={settings} />
        <a class="link" href={settings.mapLinkUrl} rel="noopener">
          <Icon name="pin" />
          Directions in Google Maps
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    gap: var(--space-8);
  }
  .form {
    display: grid;
    gap: var(--space-5);
  }
  .form__row {
    display: grid;
    gap: var(--space-5);
  }
  .form__field {
    display: grid;
    gap: 0.4rem;
  }
  .form__label {
    font-size: var(--fs-caption);
    font-weight: 500;
    color: var(--ink);
  }
  .form__optional {
    font-weight: 400;
    color: var(--ink-muted);
    margin-left: 0.35em;
  }
  .form input,
  .form textarea,
  .form select {
    width: 100%;
    font: inherit;
    color: var(--ink);
    background: var(--canvas);
    border: 1px solid var(--line-control);
    border-radius: var(--radius-sm);
    padding: 0.7rem 0.85rem;
    transition:
      border-color var(--dur-fast) ease,
      box-shadow var(--dur-fast) ease;
  }
  .form input::placeholder,
  .form textarea::placeholder {
    color: var(--ink-muted);
  }
  .form input:focus-visible,
  .form textarea:focus-visible,
  .form select:focus-visible {
    /* The site-wide focus ring (global.css) stays; the border deepens with it. */
    border-color: var(--pink-ink);
  }
  .form textarea {
    resize: vertical;
    min-height: 7rem;
  }
  .form__select {
    position: relative;
    display: block;
  }
  .form select {
    appearance: none;
    padding-right: 2.25rem;
    cursor: pointer;
  }
  .form__select::after {
    content: "";
    position: absolute;
    right: 0.95rem;
    top: 50%;
    width: 0.5rem;
    height: 0.5rem;
    border-right: 1.5px solid var(--ink-muted);
    border-bottom: 1.5px solid var(--ink-muted);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }
  .form__trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .form__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-top: var(--space-2);
  }
  .form__aside {
    font-size: var(--fs-small);
    color: var(--ink-muted);
  }
  .form__aside a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 500;
    color: var(--pink-ink);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .form__consent {
    font-size: var(--fs-caption);
    color: var(--ink-muted);
    max-width: 52ch;
  }
  .form__consent a {
    color: inherit;
    text-decoration-color: currentColor;
  }
  .form__status {
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--line-pink);
    border-radius: var(--radius-sm);
    background: var(--pale-green);
    color: var(--pale-green-ink);
    font-size: var(--fs-small);
  }
  .form__status[data-tone="error"] {
    background: var(--pale-red);
    color: var(--pale-red-ink);
  }
  .form__status,
  .form [data-submit] {
    scroll-margin-bottom: calc(var(--callbar-h) + 1.5rem);
  }
  .form[data-state="submitting"] [data-submit] {
    opacity: 0.6;
    pointer-events: none;
  }
  .form :is(input, textarea)[aria-invalid="true"] {
    border-color: var(--pale-red-ink);
  }

  .contact__card {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .contact__head {
    font-weight: 500;
    color: var(--ink);
  }
  .contact__address {
    font-style: normal;
    line-height: 1.5;
    color: var(--ink-body);
  }
  @media (min-width: 40rem) {
    .form__row {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 60rem) {
    .contact__grid {
      grid-template-columns: 3fr 2fr;
      gap: var(--space-9);
    }
  }
</style>

<script>
  // Progressive enhancement over a form that works without JavaScript (the endpoint answers a
  // plain post with a redirect to /thanks or /not-sent). With the script: field-level messages
  // tied to each field by aria-describedby, focus on the first problem, and an in-place result.
  const openedAt = performance.now();
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  if (form) {
    form.noValidate = true;
    const status = form.querySelector<HTMLElement>("[data-status]")!;
    const label = form.querySelector<HTMLElement>("[data-submit-label]")!;
    const idle = label.textContent ?? "Send request";
    const say = (text: string, tone: "ok" | "error") => {
      status.textContent = text;
      status.dataset.tone = tone;
      status.hidden = false;
    };

    // Mirrors src/lib/contact.ts, so the visitor hears about a problem before sending.
    const isPhone = (s: string) => (s.match(/\d/g) ?? []).length >= 7 && /^[\d\s()+.\-x]+$/i.test(s);
    const isEmail = (s: string) => /^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$/.test(s);
    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement;

    const MESSAGES: Record<string, string> = {
      "missing-fields": "A name, a phone number, and a few words about what you would like are all Pomi needs.",
      "invalid-phone": "Please check the phone number. Pomi will use it to call or text you back.",
      "invalid-email": "That email address looks incomplete. You can also leave it empty.",
      "rate-limited": "That is a lot of sends in a minute. Please wait a moment, or call the studio.",
    };
    const FALLBACK = "That did not go through. Please call or text the studio instead; the number is right here.";

    const mark = (el: HTMLElement, bad: boolean) => {
      el.setAttribute("aria-invalid", String(bad));
      if (bad) el.setAttribute("aria-describedby", status.id);
      else el.removeAttribute("aria-describedby");
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const name = field("name");
      const phone = field("phone");
      const email = field("email");
      const message = field("message");
      const checks: [HTMLInputElement | HTMLTextAreaElement, boolean, string][] = [
        [name, !name.value.trim(), "missing-fields"],
        [phone, !phone.value.trim(), "missing-fields"],
        [phone, !!phone.value.trim() && !isPhone(phone.value.trim()), "invalid-phone"],
        [email, !!email.value.trim() && !isEmail(email.value.trim()), "invalid-email"],
        [message, !message.value.trim(), "missing-fields"],
      ];
      let first: { el: HTMLElement; reason: string } | null = null;
      const bad = new Set<HTMLElement>();
      for (const [el, isBad, reason] of checks) {
        if (isBad) {
          bad.add(el);
          if (!first) first = { el, reason };
        }
      }
      for (const el of [name, phone, email, message]) mark(el, bad.has(el));
      if (first) {
        say(MESSAGES[first.reason], "error");
        first.el.focus();
        return;
      }

      form.dataset.state = "submitting";
      label.textContent = "Sending";
      status.hidden = true;
      // How long the form was open; the endpoint quietly drops sends faster than a person types.
      const data = { ...Object.fromEntries(new FormData(form).entries()), elapsed: Math.round(performance.now() - openedAt) };

      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(data),
        });
        const body = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
        if (res.ok && body.ok) {
          form.reset();
          label.textContent = "Sent";
          say("Sent. Pomi will call or text you back, usually the same day.", "ok");
        } else {
          label.textContent = idle;
          say((body.error && MESSAGES[body.error]) || FALLBACK, "error");
          if (body.error === "invalid-phone") phone.focus();
          if (body.error === "invalid-email") email.focus();
        }
      } catch {
        label.textContent = idle;
        say(FALLBACK, "error");
      } finally {
        delete form.dataset.state;
      }
    });
  }
</script>
