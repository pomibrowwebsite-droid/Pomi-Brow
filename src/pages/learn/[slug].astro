---
// One page per Learn article, in the shared reader shell.
//
// Two of the ten have a real body carried over from the live site. The other eight have only
// their summary, which is real copy written for this rebuild -- those pages lead with the
// summary and the photograph rather than padding with invented prose. The body renders the
// moment Pomi writes one in Sanity; nothing here needs changing.
import Base from "../../layouts/Base.astro";
import LearnReader from "../../components/LearnReader.astro";
import CtaBand from "../../components/CtaBand.astro";
import { getSiteSettings, getServices, getLearnArticles } from "../../lib/content";

export async function getStaticPaths() {
  const learn = await getLearnArticles();
  return learn.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const [settings, services, learn] = await Promise.all([getSiteSettings(), getServices(), getLearnArticles()]);
---

<Base
  title={article.seoTitle || `${article.title} | ${settings.businessName}`}
  description={article.summary}
  settings={settings}
  services={services}
  canonicalPath={`/learn/${article.slug}`}
>
  <LearnReader article={article} learn={learn} services={services} settings={settings} />
  <CtaBand
    id="learn-ask"
    heading="Ask Pomi about your own brows."
    text="Every face is different. Call or text and Pomi will tell you what would suit you, or send a request from any page."
    settings={settings}
    links={[{ href: "/contact", label: "Request an appointment" }]}
  />
</Base>
