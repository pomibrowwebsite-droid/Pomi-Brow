---
// The shared frame for the policy pages (privacy, accessibility, terms): the subpage header,
// one readable column of prose, and the standard closing call. Kept plain on purpose -- these
// pages are read to find one answer, so the column is narrow, the sections are real h2s with
// ids a footer link can land on, and nothing animates.
import Base from "./Base.astro";
import PageHeader from "../components/PageHeader.astro";
import CtaBand from "../components/CtaBand.astro";
import { getSiteSettings, getServices } from "../lib/content";

interface Props {
  /** The document title, e.g. "Privacy & Cookie Policy". */
  title: string;
  /** The on-page h1, in the site's voice, e.g. "Privacy & cookies." */
  heading: string;
  lede: string;
  description: string;
  path: string;
  /** Shown under the lede, e.g. "Last updated November 13, 2026". */
  updated: string;
}
const { title, heading, lede, description, path, updated } = Astro.props;
const [settings, services] = await Promise.all([getSiteSettings(), getServices()]);
---

<Base title={`${title} | ${settings.businessName}`} description={description} settings={settings} services={services} canonicalPath={path}>
  <PageHeader title={heading} lede={lede} meta={updated} />

  <section class="section">
    <div class="page">
      <div class="legal">
        <slot />
      </div>
    </div>
  </section>

  <CtaBand
    id="legal-ask"
    heading="Questions about any of this?"
    text="Pomi answers the studio phone herself. Call or text, or stop by the studio."
    settings={settings}
    links={[{ href: "/contact", label: "Other ways to reach the studio" }]}
  />
</Base>

<style>
  .legal {
    max-width: 44rem;
    color: var(--ink-body);
    line-height: 1.65;
  }
  .legal :global(h2) {
    font-size: var(--fs-h3);
    font-family: inherit;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }
  .legal :global(h2:first-child) {
    margin-top: 0;
  }
  .legal :global(h3) {
    font-size: 1rem;
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
  }
  .legal :global(p + p),
  .legal :global(ul + p),
  .legal :global(p + ul) {
    margin-top: 0.85em;
  }
  .legal :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.4em;
  }
  .legal :global(a) {
    color: var(--pink-ink);
    text-decoration-color: currentColor;
  }
  .legal :global(address) {
    font-style: normal;
    margin-top: 0.85em;
  }
</style>
