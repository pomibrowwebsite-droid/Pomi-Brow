# Response headers for every static page and asset (Cloudflare Workers static assets and Pages
# both read this file). The API's headers are set in src/worker.ts.
#
# {{SCRIPT_HASHES}} is filled in after the build by scripts/csp-hashes.mjs with the sha256 of
# every inline script Astro emitted, so script-src never needs 'unsafe-inline'. The build fails
# if the token is left in place. style-src keeps 'unsafe-inline' because components set CSS
# custom properties through style="" attributes, which hashes cannot cover.

/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' {{SCRIPT_HASHES}} https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.sanity.io https://*.cdninstagram.com https://*.fbcdn.net; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; frame-src https://www.google.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Hashed build assets never change under the same name.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Sanity Studio is a large client app with its own needs (the Sanity API, websockets); it is
# protected by Sanity's own login. Keep it out of search and off the site's script policy.
/admin
  ! Content-Security-Policy
  ! Cross-Origin-Opener-Policy
  X-Robots-Tag: noindex, nofollow
/admin/*
  ! Content-Security-Policy
  ! Cross-Origin-Opener-Policy
  X-Robots-Tag: noindex, nofollow
